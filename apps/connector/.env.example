CONNECTOR_HOST=127.0.0.1
CONNECTOR_PORT=4318
# Desktop launcher icin varsayilan provider.
CONNECTOR_PROVIDER=chatgpt-web
CONNECTOR_STATE_DIR=.state
# Varsayilan olarak gercek Chrome kanali denenir. Bos birakmak icin CONNECTOR_BROWSER_CHANNEL=
CONNECTOR_BROWSER_CHANNEL=chrome
# Chrome acilamazsa denenebilecek ek kanallar (virgulle ayir).
CONNECTOR_BROWSER_FALLBACK_CHANNELS=msedge
