{
  "name": "dropshiping2bizbize-workflow",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:api": "pnpm --filter @dropshiping2bizbize/api dev",
    "dev:web": "pnpm --filter @dropshiping2bizbize/web dev",
    "dev:connector": "pnpm --filter @dropshiping2bizbize/connector dev",
    "test:e2e": "pnpm --filter @dropshiping2bizbize/web test:e2e",
    "cf:deploy:api": "pnpm --filter @dropshiping2bizbize/api run deploy",
    "cf:build:web": "pnpm --filter @dropshiping2bizbize/web build",
    "cf:guard": "node scripts/cloudflare/ensure-target-account.mjs",
    "cf:d1:migrate:prod": "pnpm --filter @dropshiping2bizbize/api run d1:migrate:prod",
    "cf:d1:migrate:dev": "pnpm --filter @dropshiping2bizbize/api run d1:migrate:dev",
    "cf:deploy:api:dev": "pnpm --filter @dropshiping2bizbize/api run deploy:dev",
    "cf:secret": "node scripts/cloudflare/worker-secret.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "playwright": "^1.52.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
